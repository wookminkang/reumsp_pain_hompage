# 배포 도메인 재정의 (기본값: https://www.reumpainclinic.com — lib/clinic.ts SITE_URL)
# NEXT_PUBLIC_SITE_URL=https://www.reumpainclinic.com

# 네이버 클라우드 플랫폼 Dynamic Map(Maps JS API) 인증 키 — 넣으면 오시는길 지도가 활성화됨
# NCP 콘솔 > AI·NAVER API > Maps > 인증 정보의 "Client ID"(신규 발급 키는 Key ID)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 검색엔진 소유확인 코드 — 발급받은 content 값만 넣으면 <meta> 태그가 자동 출력됨 (app/layout.tsx verification)
# 네이버 서치어드바이저 > 사이트 등록 > HTML 태그 방식의 content 값
NAVER_SITE_VERIFICATION=
# 구글 서치콘솔 > 소유권 확인 > HTML 태그 방식의 content 값
GOOGLE_SITE_VERIFICATION=
